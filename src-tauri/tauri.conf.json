{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cancioneiro",
  "version": "0.12.2",
  "identifier": "br.com.avantsoft.cancioneiro",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Cancioneiro",
        "width": 1200,
        "height": 760,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYzN0Q5MzA4REVFRTQ4NTcKUldSWFNPN2VDSk45WXkraVFMQ2c0bUY5TlJCQVlsSXJkNWdTQUpzcVJveVR2TGdHYnhPcmNtZmQK",
      "endpoints": [
        "https://github.com/gabrielnader/cancioneiro/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
